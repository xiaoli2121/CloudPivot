<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>io.cloudpivot</groupId>
  <artifactId>cloudpivot-springboot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>cloudpivot-springboot</name>
  <description>CloudPivot Spring Boot modular backend</description>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.15</mybatis-plus.version>
    <shiro.version>2.0.1</shiro.version>
    <shiro.classifier>jakarta</shiro.classifier>
    <spring-boot.run.skip>true</spring-boot.run.skip>
  </properties>

  <modules>
    <module>cloudpivot-boot</module>
    <module>cloudpivot-common</module>
    <module>cloudpivot-platform</module>
    <module>cloudpivot-engine</module>
    <module>cloudpivot-plugin</module>
  </modules>
</project>
